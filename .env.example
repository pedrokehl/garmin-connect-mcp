# Copy to .env and fill in. Never commit .env.

# Required. Your Garmin Connect Personal API key.
# Create it at https://connect.garmin.com/app/settings/personalApiToken (shown only once).
GARMIN_API_KEY=

# Required for the HTTP deployment (Vercel, etc.), ignored by the local stdio server.
# A long random secret that MCP clients send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -base64 32
MCP_AUTH_TOKEN=

# Optional. Override the Garmin API host (defaults to https://personal.connectapi.garmin.com).
# GARMIN_API_BASE_URL=

# Optional, stdio only. When set, garmin_download_activity_file saves files here
# and returns the path instead of returning the file inline.
# GARMIN_DOWNLOAD_DIR=~/Downloads/garmin
