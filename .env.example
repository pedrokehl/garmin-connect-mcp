# Copy to .env and fill in. Never commit .env.

# Required. Your Garmin Connect Personal API key.
# Create it at https://connect.garmin.com/app/settings/personalApiToken (shown only once).
GARMIN_API_KEY=

# HTTP deployment only (ignored by the local stdio server): set MCP_AUTH_TOKEN,
# MCP_OAUTH_CLIENT_SECRET, or both. Generate each with: openssl rand -base64 32

# For clients that send "Authorization: Bearer <token>" (Claude Code, Cursor, Gemini CLI).
MCP_AUTH_TOKEN=

# For OAuth clients that can't send a header (the Gemini app, claude.ai). Enter it in the app
# with client ID "garmin-mcp". Without MCP_AUTH_TOKEN, the sign-in page asks for this secret.
MCP_OAUTH_CLIENT_SECRET=
# Optional override of the OAuth client ID (default: garmin-mcp).
# MCP_OAUTH_CLIENT_ID=
# Extra allowed OAuth callback URLs, comma-separated (Gemini, claude.ai, ChatGPT and localhost are built in).
# MCP_OAUTH_REDIRECT_URIS=

# Optional. Override the Garmin API host (defaults to https://personal.connectapi.garmin.com).
# GARMIN_API_BASE_URL=

# Optional, stdio only. When set, garmin_download_activity_file saves files here
# and returns the path instead of returning the file inline.
# GARMIN_DOWNLOAD_DIR=~/Downloads/garmin
