{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/oauth/:action", "destination": "/api/mcp?__route=/oauth/:action" },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?__route=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp?__route=/.well-known/oauth-protected-resource/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?__route=/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/mcp?__route=/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/mcp?__route=/.well-known/openid-configuration"
    }
  ]
}
